# MIDNIGHT — environment (names only; never commit real secrets)
# Copy to `.env` (gitignored) — the server auto-loads it on boot, no `export` needed.

# Port the server listens on
PORT=3000

# --- Voice (spec §4) ---
# ElevenLabs API key. Set it to have the game master voice EVERY line at runtime
# (including player names). Without it, the prebaked Vlad lines (content/audio/tts/)
# cover the fixed narration and the rest falls back to browser TTS. Nothing breaks.
ELEVENLABS_API_KEY=

# Optional phase-timer overrides (seconds); defaults 60 / 120 / 45.
# NIGHT_SECONDS=60
# DISCUSSION_SECONDS=120
# VOTE_SECONDS=45

# --- (Phase 3) Audio capture / transcription / storage (spec §6) ---
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# R2_BUCKET=
